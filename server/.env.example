# Matches the local docker-compose Postgres service — see docker-compose.yml at the repo root.
DATABASE_URL="postgresql://algoquest:algoquest@localhost:5432/algoquest?schema=public"

# Generate your own local values, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-a-random-hex-string"
JWT_REFRESH_SECRET="replace-with-a-different-random-hex-string"

# Matches the local docker-compose Judge0 stack — see judge0.conf.example (AUTHN_TOKEN).
JUDGE0_URL="http://localhost:2358"
JUDGE0_AUTH_TOKEN="replace-with-the-AUTHN_TOKEN-value-from-your-judge0.conf"
